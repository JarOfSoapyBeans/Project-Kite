PORT=8080
# Your Kite frontend URL(s), comma-separated.
ALLOWED_ORIGINS=https://your-kite.vercel.app,http://localhost:3000
MAX_ACTIVE_PER_IP=100
# Set to 1 only when running behind a Cloudflare Tunnel
TRUST_CF=0
MAX_WEBSOCKETS_PER_IP=30
# Keep site cookies (your logins) across restarts. Keep this file private.
COOKIE_FILE=./kite-cookies.json
